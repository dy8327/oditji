<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.project.oditji.event.dao.EventDAO">

    <!-- 승인된 이벤트를 시작일과 종료일 기준으로 분류합니다. -->
    <select id="selectEventList"
            parameterType="string"
            resultType="com.project.oditji.event.vo.EventVO">

        SELECT
            EVENT_NO,
            TITLE,
            DESCRIPTION,
            BANNER_IMAGE,
            START_DATE,
            END_DATE,
            STATUS,
            CREATED_AT

        FROM EVENT

        WHERE 1=1

        <!--
            START_DATE / END_DATE는 DATE 타입이라 시간까지 저장된다.
            (관리자 입력값은 보통 00:00:00로 저장됨)
            SYSDATE와 그대로 비교하면 END_DATE 당일 자정이 지나는 순간
            바로 "종료"로 분류되는 문제가 있어, TRUNC로 날짜만 비교한다.
            즉 START_DATE ~ END_DATE 를 "그 날짜들 전체"로 취급한다.

            [수정] 예전에는 period와 무관하게 STATUS = 'APPROVED'를 먼저 걸어뒀는데,
            EventStatusScheduler(매일 00:05)가 종료일이 지난 이벤트의 STATUS를
            APPROVED -> END로 자동 전환하기 때문에, 스케줄러가 한 번이라도 돌고 나면
            종료된 이벤트는 더 이상 STATUS = 'APPROVED'가 아니게 되어 "종료" 탭에
            하나도 조회되지 않는 문제가 있었다. 그래서 STATUS 조건을 period별로
            분리해, 종료(ended) 조회 시에는 스케줄러가 이미 END로 바꿔놓은 이벤트와
            아직 스케줄러가 돌기 전이라 APPROVED로 남아있는 이벤트를 모두 포함한다.
        -->
        <choose>
            <when test="_parameter == 'upcoming'">
                AND STATUS = 'APPROVED'
                AND TRUNC(START_DATE) &gt; TRUNC(SYSDATE)
            </when>

            <when test="_parameter == 'ended'">
                AND STATUS IN ('APPROVED', 'END')
                AND TRUNC(END_DATE) &lt; TRUNC(SYSDATE)
            </when>

            <otherwise>
                AND STATUS = 'APPROVED'
                AND TRUNC(START_DATE) <![CDATA[ <= ]]> TRUNC(SYSDATE)
                AND TRUNC(END_DATE) <![CDATA[ >= ]]> TRUNC(SYSDATE)
            </otherwise>
        </choose>

        ORDER BY
            CASE WHEN START_DATE IS NULL THEN 1 ELSE 0 END,
            START_DATE DESC,
            EVENT_NO DESC

    </select>

    <select id="selectEventDetail"
            resultMap="eventDetailResult">

        SELECT
            E.EVENT_NO,
            E.TITLE,
            E.DESCRIPTION,
            E.BANNER_IMAGE,
            E.START_DATE,
            E.END_DATE,
            E.STATUS,
            E.CREATED_AT,
            P.PRODUCT_NO,
            P.PRODUCT_NAME,
            P.PRICE,
            PI.IMAGE_PATH,
            EP.EVENT_DISCOUNT_RATE

        FROM EVENT E

        JOIN EVENT_PRODUCT EP
            ON E.EVENT_NO = EP.EVENT_NO

        JOIN PRODUCT P
            ON EP.PRODUCT_NO = P.PRODUCT_NO

        LEFT JOIN PRODUCT_IMAGE PI
            ON P.PRODUCT_NO = PI.PRODUCT_NO
           AND PI.IS_MAIN = 'Y'

        WHERE E.EVENT_NO = #{eventNo}
          <!-- [수정] 종료일이 지나 EventStatusScheduler가 STATUS를 END로 바꾼 이벤트도
               상세 페이지(예: "종료" 목록에서 들어온 링크)에서 계속 조회할 수 있어야 하므로
               APPROVED 외에 END 상태도 함께 허용한다. -->
          AND E.STATUS IN ('APPROVED', 'END')

    </select>

    <resultMap id="eventDetailResult"
               type="com.project.oditji.event.vo.EventVO">

        <id property="eventNo" column="EVENT_NO"/>
        <result property="title" column="TITLE"/>
        <result property="description" column="DESCRIPTION"/>
        <result property="bannerImage" column="BANNER_IMAGE"/>
        <result property="startDate" column="START_DATE"/>
        <result property="endDate" column="END_DATE"/>
        <result property="status" column="STATUS"/>
        <result property="createdAt" column="CREATED_AT"/>

        <collection property="products"
                    ofType="com.project.oditji.event.vo.EventProductVO">
            <id property="productNo" column="PRODUCT_NO"/>
            <result property="productName" column="PRODUCT_NAME"/>
            <result property="price" column="PRICE"/>
            <result property="eventDiscountRate" column="EVENT_DISCOUNT_RATE"/>
            <result property="imagePath" column="IMAGE_PATH"/>
        </collection>

    </resultMap>

</mapper>
