<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.project.oditji.event.dao.EventDAO">


    <!-- =========================
         사용자 이벤트 목록
         ========================= -->

    <select id="selectEventList"
            resultType="com.project.oditji.event.vo.EventVO">

        SELECT
            EVENT_NO,
            TITLE,
            BANNER_IMAGE,
            START_DATE,
            END_DATE,
            STATUS,
            CREATED_AT

        FROM EVENT

        WHERE STATUS = 'APPROVED'

        ORDER BY EVENT_NO DESC

    </select>



    <!-- =========================
         사용자 이벤트 상세
         ========================= -->

    <select id="selectEventDetail"
            resultMap="eventDetailResult">

        SELECT

            E.EVENT_NO,
            E.TITLE,
            E.BANNER_IMAGE,
            E.START_DATE,
            E.END_DATE,
            E.STATUS,
            E.CREATED_AT,

            P.PRODUCT_NO,
            P.PRODUCT_NAME,
            P.PRICE,

            PI.IMAGE_PATH,

            EP.EVENT_DISCOUNT_RATE

        FROM EVENT E

        JOIN EVENT_PRODUCT EP
        ON E.EVENT_NO = EP.EVENT_NO

        JOIN PRODUCT P
        ON EP.PRODUCT_NO = P.PRODUCT_NO

        LEFT JOIN PRODUCT_IMAGE PI
        ON P.PRODUCT_NO = PI.PRODUCT_NO
        AND PI.IS_MAIN = 'Y'

        WHERE E.EVENT_NO = #{eventNo}

    </select>



    <!-- =========================
         이벤트 상세 ResultMap
         ========================= -->

    <resultMap id="eventDetailResult"
               type="com.project.oditji.event.vo.EventVO">


        <id property="eventNo"
            column="EVENT_NO"/>


        <result property="title"
                column="TITLE"/>


        <result property="bannerImage"
                column="BANNER_IMAGE"/>


        <result property="startDate"
                column="START_DATE"/>


        <result property="endDate"
                column="END_DATE"/>


        <result property="status"
                column="STATUS"/>


        <result property="createdAt"
                column="CREATED_AT"/>



        <collection property="products"
                    ofType="com.project.oditji.event.vo.EventProductVO">


            <result property="productNo"
                    column="PRODUCT_NO"/>


            <result property="productName"
                    column="PRODUCT_NAME"/>


            <result property="price"
                    column="PRICE"/>


            <result property="eventDiscountRate"
                    column="EVENT_DISCOUNT_RATE"/>


            <result property="imagePath"
                    column="IMAGE_PATH"/>


        </collection>


    </resultMap>


</mapper>