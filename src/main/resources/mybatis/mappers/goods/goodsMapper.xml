<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.project.oditji.goods.dao.GoodsDAO">

    <resultMap id="goodsResultMap"
               type="com.project.oditji.goods.vo.GoodsVO">

        <id property="productNo" column="PRODUCT_NO"/>
        <result property="productName" column="PRODUCT_NAME"/>
        <result property="productType" column="PRODUCT_TYPE"/>
        <result property="price" column="PRICE"/>
        <result property="discountRate" column="DISCOUNT_RATE"/>
        <result property="stock" column="STOCK"/>
        <result property="description" column="DESCRIPTION"/>
        <result property="status" column="STATUS"/>
        <result property="businessName" column="BUSINESS_NAME"/>
        <result property="mainImage" column="MAIN_IMAGE"/>

    </resultMap>

    <sql id="searchGoodsFilterCondition">
        WHERE P.STATUS = 'ON_SALE'

          AND LOWER(P.PRODUCT_NAME)
                LIKE '%' || LOWER(#{keyword}) || '%'

        <if test="productTypes != null and productTypes.size() > 0">
            AND P.PRODUCT_TYPE IN
            <foreach collection="productTypes"
                     item="productType"
                     open="("
                     separator=","
                     close=")">
                #{productType}
            </foreach>
        </if>

        <if test="minPrice != null">
            AND FLOOR(
                    P.PRICE
                    * (100 - NVL(P.DISCOUNT_RATE, 0))
                    / 100
                ) <![CDATA[ >= ]]> #{minPrice}
        </if>

        <if test="maxPrice != null">
            AND FLOOR(
                    P.PRICE
                    * (100 - NVL(P.DISCOUNT_RATE, 0))
                    / 100
                ) <![CDATA[ <= ]]> #{maxPrice}
        </if>

        <if test="discountOnly">
            AND NVL(P.DISCOUNT_RATE, 0) > 0
        </if>

        <if test="inStockOnly">
            AND NVL(P.STOCK, 0) > 0
        </if>
    </sql>

    <select id="selectSearchGoods"
            resultMap="goodsResultMap">

        SELECT
            PAGED.PRODUCT_NO,
            PAGED.PRODUCT_NAME,
            PAGED.PRODUCT_TYPE,
            PAGED.PRICE,
            PAGED.DISCOUNT_RATE,
            PAGED.STOCK,
            PAGED.DESCRIPTION,
            PAGED.STATUS,
            PAGED.BUSINESS_NAME,
            PAGED.MAIN_IMAGE
        FROM (
            SELECT
                ROW_NUMBER() OVER (
                    ORDER BY
                        P.CREATED_AT DESC,
                        P.PRODUCT_NO DESC
                ) AS RN,

                P.PRODUCT_NO,
                P.PRODUCT_NAME,
                P.PRODUCT_TYPE,
                P.PRICE,
                P.DISCOUNT_RATE,
                P.STOCK,
                P.DESCRIPTION,
                P.STATUS,
                B.BUSINESS_NAME,
                PI.MAIN_IMAGE

            FROM PRODUCT P

            INNER JOIN BUSINESS B
                ON B.BUSINESS_NO = P.BUSINESS_NO

            LEFT JOIN (
                SELECT
                    PRODUCT_NO,
                    MAX(IMAGE_PATH)
                        KEEP (
                            DENSE_RANK FIRST
                            ORDER BY
                                CASE
                                    WHEN IS_MAIN = 'Y' THEN 0
                                    ELSE 1
                                END,
                                IMAGE_NO
                        ) AS MAIN_IMAGE
                FROM PRODUCT_IMAGE
                GROUP BY PRODUCT_NO
            ) PI
                ON PI.PRODUCT_NO = P.PRODUCT_NO

            <include refid="searchGoodsFilterCondition"/>
        ) PAGED

        WHERE PAGED.RN BETWEEN #{startRow} AND #{endRow}

        ORDER BY PAGED.RN

    </select>

    <select id="countSearchGoods"
            resultType="int">

        SELECT COUNT(*)
        FROM PRODUCT P

        <include refid="searchGoodsFilterCondition"/>

    </select>

    <select id="selectSearchProductTypes"
            resultType="string">

        SELECT DISTINCT P.PRODUCT_TYPE
        FROM PRODUCT P
        WHERE P.STATUS = 'ON_SALE'
          AND P.PRODUCT_TYPE IS NOT NULL
        ORDER BY P.PRODUCT_TYPE

    </select>

</mapper>
