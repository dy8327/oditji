<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.project.oditji.goods.dao.GoodsDAO">

    <!-- =====================================================
         상품 조회 결과
    ====================================================== -->
    <resultMap id="goodsResultMap"
               type="com.project.oditji.goods.vo.GoodsVO">

        <id property="productNo"
            column="PRODUCT_NO"/>

        <result property="businessNo"
                column="BUSINESS_NO"/>

        <result property="contentNo"
                column="CONTENT_NO"/>

        <result property="actorNo"
                column="ACTOR_NO"/>

        <result property="productName"
                column="PRODUCT_NAME"/>

        <result property="productType"
                column="PRODUCT_TYPE"/>

        <result property="price"
                column="PRICE"/>

        <result property="discountRate"
                column="DISCOUNT_RATE"/>

        <result property="stock"
                column="STOCK"/>

        <result property="description"
                column="DESCRIPTION"/>

        <result property="status"
                column="STATUS"/>

        <result property="businessName"
                column="BUSINESS_NAME"/>

        <result property="mainImage"
                column="MAIN_IMAGE"/>

    </resultMap>

    <!-- =====================================================
         공통 상품 필터 조건
    ====================================================== -->
    <sql id="searchGoodsFilterCondition">

        WHERE P.STATUS = 'ON_SALE'

        <if test="keyword != null and keyword != ''">

            AND (
                    LOWER(P.PRODUCT_NAME)
                        LIKE '%' || LOWER(#{keyword}) || '%'

                    OR LOWER(B.BUSINESS_NAME)
                        LIKE '%' || LOWER(#{keyword}) || '%'
                )

        </if>

        <if test="
            productTypes != null
            and productTypes.size() > 0
        ">

            AND P.PRODUCT_TYPE IN

            <foreach collection="productTypes"
                     item="productType"
                     open="("
                     separator=","
                     close=")">

                #{productType}

            </foreach>

        </if>

        <if test="minPrice != null">

            AND FLOOR(
                    P.PRICE
                    * (
                        100
                        - NVL(P.DISCOUNT_RATE, 0)
                    )
                    / 100
                )
                <![CDATA[ >= ]]>
                #{minPrice}

        </if>

        <if test="maxPrice != null">

            AND FLOOR(
                    P.PRICE
                    * (
                        100
                        - NVL(P.DISCOUNT_RATE, 0)
                    )
                    / 100
                )
                <![CDATA[ <= ]]>
                #{maxPrice}

        </if>

        <if test="discountOnly">

            AND NVL(P.DISCOUNT_RATE, 0) > 0

        </if>

        <if test="inStockOnly">

            AND NVL(P.STOCK, 0) > 0

        </if>

    </sql>

    <!-- =====================================================
         상품 목록 조회
    ====================================================== -->
    <select id="selectSearchGoods"
            resultMap="goodsResultMap">

        SELECT
            PAGED.PRODUCT_NO,
            PAGED.BUSINESS_NO,
            PAGED.CONTENT_NO,
            PAGED.ACTOR_NO,
            PAGED.PRODUCT_NAME,
            PAGED.PRODUCT_TYPE,
            PAGED.PRICE,
            PAGED.DISCOUNT_RATE,
            PAGED.STOCK,
            PAGED.DESCRIPTION,
            PAGED.STATUS,
            PAGED.BUSINESS_NAME,
            PAGED.MAIN_IMAGE

        FROM (

            SELECT
                ROW_NUMBER() OVER (

                    ORDER BY
                        P.CREATED_AT DESC,
                        P.PRODUCT_NO DESC

                ) AS RN,

                P.PRODUCT_NO,
                P.BUSINESS_NO,
                P.CONTENT_NO,
                P.ACTOR_NO,
                P.PRODUCT_NAME,
                P.PRODUCT_TYPE,
                P.PRICE,
                P.DISCOUNT_RATE,
                P.STOCK,
                P.DESCRIPTION,
                P.STATUS,
                B.BUSINESS_NAME,
                PI.MAIN_IMAGE

            FROM PRODUCT P

            INNER JOIN BUSINESS B
                ON B.BUSINESS_NO = P.BUSINESS_NO

            LEFT JOIN (

                SELECT
                    PRODUCT_NO,

                    MAX(IMAGE_PATH)
                    KEEP (
                        DENSE_RANK FIRST
                        ORDER BY
                            CASE
                                WHEN IS_MAIN = 'Y'
                                    THEN 0
                                ELSE 1
                            END,
                            IMAGE_NO
                    ) AS MAIN_IMAGE

                FROM PRODUCT_IMAGE

                GROUP BY PRODUCT_NO

            ) PI
                ON PI.PRODUCT_NO = P.PRODUCT_NO

            <include refid="searchGoodsFilterCondition"/>

        ) PAGED

        WHERE PAGED.RN
              BETWEEN #{startRow}
              AND #{endRow}

        ORDER BY PAGED.RN

    </select>

    <!-- =====================================================
         상품 개수
    ====================================================== -->
    <select id="countSearchGoods"
            resultType="int">

        SELECT COUNT(*)

        FROM PRODUCT P

        INNER JOIN BUSINESS B
            ON B.BUSINESS_NO = P.BUSINESS_NO

        <include refid="searchGoodsFilterCondition"/>

    </select>

    <!-- =====================================================
         추천 상품
         판매 중이며 재고가 있는 상품 우선
    ====================================================== -->
    <select id="selectRecommendedGoods"
            resultMap="goodsResultMap">

        SELECT
            RECOMMENDED.PRODUCT_NO,
            RECOMMENDED.BUSINESS_NO,
            RECOMMENDED.CONTENT_NO,
            RECOMMENDED.ACTOR_NO,
            RECOMMENDED.PRODUCT_NAME,
            RECOMMENDED.PRODUCT_TYPE,
            RECOMMENDED.PRICE,
            RECOMMENDED.DISCOUNT_RATE,
            RECOMMENDED.STOCK,
            RECOMMENDED.DESCRIPTION,
            RECOMMENDED.STATUS,
            RECOMMENDED.BUSINESS_NAME,
            RECOMMENDED.MAIN_IMAGE

        FROM (

            SELECT
                ROW_NUMBER() OVER (

                    ORDER BY
                        CASE
                            WHEN NVL(P.STOCK, 0) > 0
                                THEN 0
                            ELSE 1
                        END,
                        NVL(P.DISCOUNT_RATE, 0) DESC,
                        P.CREATED_AT DESC,
                        P.PRODUCT_NO DESC

                ) AS RN,

                P.PRODUCT_NO,
                P.BUSINESS_NO,
                P.CONTENT_NO,
                P.ACTOR_NO,
                P.PRODUCT_NAME,
                P.PRODUCT_TYPE,
                P.PRICE,
                P.DISCOUNT_RATE,
                P.STOCK,
                P.DESCRIPTION,
                P.STATUS,
                B.BUSINESS_NAME,
                PI.MAIN_IMAGE

            FROM PRODUCT P

            INNER JOIN BUSINESS B
                ON B.BUSINESS_NO = P.BUSINESS_NO

            LEFT JOIN (

                SELECT
                    PRODUCT_NO,

                    MAX(IMAGE_PATH)
                    KEEP (
                        DENSE_RANK FIRST
                        ORDER BY
                            CASE
                                WHEN IS_MAIN = 'Y'
                                    THEN 0
                                ELSE 1
                            END,
                            IMAGE_NO
                    ) AS MAIN_IMAGE

                FROM PRODUCT_IMAGE

                GROUP BY PRODUCT_NO

            ) PI
                ON PI.PRODUCT_NO = P.PRODUCT_NO

            WHERE P.STATUS = 'ON_SALE'

        ) RECOMMENDED

        WHERE RECOMMENDED.RN
              BETWEEN 1 AND #{limit}

        ORDER BY RECOMMENDED.RN

    </select>

    <!-- =====================================================
         등록된 상품 종류
    ====================================================== -->
    <select id="selectSearchProductTypes"
            resultType="string">

        SELECT DISTINCT
               P.PRODUCT_TYPE

        FROM PRODUCT P

        WHERE P.STATUS = 'ON_SALE'
          AND P.PRODUCT_TYPE IS NOT NULL

        ORDER BY P.PRODUCT_TYPE

    </select>

</mapper>